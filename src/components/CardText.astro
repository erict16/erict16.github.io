---
import { ArrowUpRightIcon } from '@heroicons/react/24/outline';

interface Props {
  arrow?: boolean;
  text: string;
}

const { arrow = false, text } = Astro.props;
---

<div class={arrow ? 'card-text has-arrow' : 'card-text'}>
  <div class="card-copy">
    <h3>
      <slot />
    </h3>
    <p>{text}</p>
  </div>
  {arrow && (
    <span aria-hidden="true" class="card-go">
      <ArrowUpRightIcon />
    </span>
  )}
</div>
